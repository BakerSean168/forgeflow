[Unit]
Description=ForgeFlow Autonomous Software Engineering Control Plane
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/home/dev/projects/forgeflow
Environment=NODE_ENV=production
Environment=FORGEFLOW_HOST=127.0.0.1
Environment=FORGEFLOW_PORT=8420
Environment=FORGEFLOW_DB=/var/lib/forgeflow/forgeflow.sqlite
Environment=FORGEFLOW_EXECUTION_RUNTIME_ENABLED=true
Environment=FORGEFLOW_AUTOMATION_RUNTIME_ENABLED=true
Environment=FORGEFLOW_AUTOMATION_POLL_MS=5000
Environment=FORGEFLOW_SUPERVISOR_RUNTIME_ENABLED=true
Environment=FORGEFLOW_SUPERVISOR_POLL_MS=5000
Environment=FORGEFLOW_RESOURCE_SELECTOR_ENABLED=true
Environment=FORGEFLOW_SINGLE_ACTIVE_PLAN_ENABLED=true
Environment=FORGEFLOW_WORKSPACE_HOST_ROOT=/var/lib/forgeflow/workspaces
Environment=FORGEFLOW_WORKSPACE_EXECUTION_ROOT=/workspace
Environment=FORGEFLOW_WORKSPACE_UID=10001
Environment=FORGEFLOW_WORKSPACE_GID=10001
Environment=FORGEFLOW_HOST_CACHE_STATE_FILE=/var/lib/forgeflow/host-cache-maintenance.json
Environment=FORGEFLOW_AGENT_HARNESS_CTL=/home/dev/projects/agent-harness/bin/harnessctl.py
Environment=FORGEFLOW_MAX_PARALLEL_WORK_ITEMS=2
Environment=FORGEFLOW_MAX_IMPLEMENTATION_ATTEMPTS=3
Environment=FORGEFLOW_MAX_REVIEW_ATTEMPTS=4
Environment=FORGEFLOW_MAX_REPAIR_CYCLES=3
EnvironmentFile=/etc/forgeflow/forgeflow.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
ReadWritePaths=/var/lib/forgeflow
# Repository write paths are intentionally host-specific. Add narrow project paths in a systemd drop-in.

[Install]
WantedBy=multi-user.target
