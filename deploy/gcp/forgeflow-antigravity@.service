[Unit]
Description=ForgeFlow Antigravity execution %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dev/projects/forgeflow
Environment=FORGEFLOW_ANTIGRAVITY_STATE_ROOT=/var/lib/forgeflow/antigravity
Environment=FORGEFLOW_WORKSPACE_HOST_ROOT=/var/lib/forgeflow/workspaces
Environment=FORGEFLOW_ANTIGRAVITY_HOME=/home/dev
Environment=FORGEFLOW_ANTIGRAVITY_BIN=/home/dev/.local/bin/agy
Environment=FORGEFLOW_ANTIGRAVITY_SANDBOX_WRAPPER=/usr/local/libexec/forgeflow-antigravity-sandbox.sh
Environment=FORGEFLOW_ANTIGRAVITY_UID=10001
Environment=FORGEFLOW_ANTIGRAVITY_GID=10001
Environment=FORGEFLOW_ANTIGRAVITY_AUTH_UID=1001
Environment=FORGEFLOW_ANTIGRAVITY_AUTH_GID=1002
Environment=FORGEFLOW_WORKSPACE_GID=10001
Environment=FORGEFLOW_ANTIGRAVITY_USER=forgeflow-worker
ExecStart=/usr/bin/node /usr/local/libexec/forgeflow-antigravity-unit.mjs %i
KillMode=control-group
Restart=no
TimeoutStartSec=30
TimeoutStopSec=15
RuntimeMaxSec=35min
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
AmbientCapabilities=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL
ReadWritePaths=/var/lib/forgeflow
