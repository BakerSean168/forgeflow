[Unit]
Description=ForgeFlow host cache high-watermark maintenance
After=docker.service forgeflow.service

[Service]
Type=oneshot
User=root
Environment=FORGEFLOW_CONTROL_PLANE_URL=http://127.0.0.1:8420
Environment=FORGEFLOW_HOST_CACHE_STATE_FILE=/var/lib/forgeflow/host-cache-maintenance.json
Environment=FORGEFLOW_HOST_CACHE_TRIGGER_FREE_BYTES=17179869184
Environment=FORGEFLOW_HOST_CACHE_TARGET_FREE_BYTES=25769803776
Environment=FORGEFLOW_HOST_CACHE_BUILD_AGE=24h
Environment=FORGEFLOW_HOST_CACHE_IMAGE_AGE=168h
ExecStart=/bin/bash /usr/local/libexec/forgeflow-prune-host-cache.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/forgeflow
