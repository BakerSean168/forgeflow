[Unit]
Description=ForgeFlow exact-SHA self-promotion runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/home/dev/projects/forgeflow
Environment=FORGEFLOW_ROOT=/home/dev/projects/forgeflow
Environment=FORGEFLOW_HEALTH_URL=http://127.0.0.1:8420/api/health
Environment=FORGEFLOW_IMPROVEMENT_SELF_PROMOTION_REQUEST_FILE=/var/lib/forgeflow/self-promotion-request.json
# Do not load forgeflow.env here. The runner verifies the live control plane's
# non-secret health projection instead of inheriting provider/API credentials.
ExecStart=/usr/local/libexec/forgeflow-self-promote.sh
TimeoutStartSec=30min
Restart=on-failure
RestartSec=60s
