# ForgeFlow control-plane configuration. Copy to /etc/forgeflow/forgeflow.env (0600).
# No project is automated until it is explicitly allowlisted here.
FORGEFLOW_AUTOMATION_PROJECTS=
FORGEFLOW_ALLOWED_REPOSITORY_ROOTS=/home/dev/projects
# Explicit canonical repositories that the controller may integrate into.
FORGEFLOW_REPOSITORY_WRITE_PATHS=
FORGEFLOW_OPENHANDS_URL=http://127.0.0.1:18420
FORGEFLOW_OPENHANDS_TOKEN=
FORGEFLOW_LITELLM_BASE_URL=
FORGEFLOW_LITELLM_API_KEY=
FORGEFLOW_LITELLM_ADMIN_BASE_URL=
FORGEFLOW_LITELLM_ADMIN_ENV_FILE=/etc/forgeflow/litellm.env
FORGEFLOW_LITELLM_ADMIN_KEY_NAME=LITELLM_MASTER_KEY
# Optional host-local, version-verified tool artifact seed for faster cold bootstrap.
FORGEFLOW_DSH_SEED_DIR=
FORGEFLOW_SUPERVISOR_MAX_RESOURCE_ATTEMPTS=3
FORGEFLOW_SUPERVISOR_ADMISSION_TTL_MS=900000
FORGEFLOW_SUPERVISOR_ADMISSION_FAILURE_TTL_MS=300000
FORGEFLOW_SUPERVISOR_ADMISSION_TIMEOUT_MS=30000
FORGEFLOW_RESOURCE_PROBE_TIMEOUT_MS=30000
# Improvement discovery/adoption are separate gates. Self-change remains disabled unless explicitly authorized.
FORGEFLOW_IMPROVEMENT_DISCOVERY_ENABLED=false
FORGEFLOW_IMPROVEMENT_ADOPTION_ENABLED=false
FORGEFLOW_IMPROVEMENT_AUTO_ADOPT_LOW_RISK=false
FORGEFLOW_IMPROVEMENT_PROJECTS=
FORGEFLOW_IMPROVEMENT_SELF_CHANGE_ENABLED=false
FORGEFLOW_IMPROVEMENT_SELF_PROJECT_KEY=forgeflow
FORGEFLOW_IMPROVEMENT_SELF_REPOSITORY=/home/dev/projects/forgeflow
FORGEFLOW_IMPROVEMENT_CYCLE_MS=30000
FORGEFLOW_BUSINESS_RESOURCE_ENABLED=false
FORGEFLOW_ANTIGRAVITY_RESOURCE_ENABLED=false
FORGEFLOW_ANTIGRAVITY_PROJECTS=
# Literal worktrees require matching project-specific Git mounts in deploy/openhands/docker-compose.override.yml.
FORGEFLOW_LITERAL_WORKTREES_ENABLED=false
FORGEFLOW_LITERAL_WORKTREE_PROJECTS=
FORGEFLOW_RELEASE_PROVENANCE_FILE=/var/lib/forgeflow/release-provenance.json
