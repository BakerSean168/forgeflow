{
  "$schema": "https://opencode.ai/config.json",
  "model": "forgeflow-litellm/gpt-5.6-luna",
  "provider": {
    "forgeflow-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ForgeFlow LiteLLM",
      "options": {
        "baseURL": "{env:FORGEFLOW_LITELLM_BASE_URL}",
        "apiKey": "{env:FORGEFLOW_LITELLM_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "Implementation Efficient",
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "options": {
            "user": "{env:FORGEFLOW_EXECUTION_ID}"
          }
        },
        "planning-premium": {
          "name": "Planning Premium",
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "options": {
            "user": "{env:FORGEFLOW_EXECUTION_ID}"
          }
        },
        "review-premium": {
          "name": "Review Premium",
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "options": {
            "user": "{env:FORGEFLOW_EXECUTION_ID}"
          }
        }
      }
    }
  }
}
