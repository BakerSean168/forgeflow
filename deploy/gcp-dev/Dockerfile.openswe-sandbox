FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates coreutils curl git gh jq openssh-client procps python3 \
       python3-venv ripgrep tar unzip xz-utils build-essential \
    && npm install --global pnpm@10.15.1 \
    && rm -rf /var/lib/apt/lists/* /root/.npm \
    && mkdir -p /workspace \
    && chown node:node /workspace

WORKDIR /workspace
USER node
CMD ["sleep", "infinity"]
