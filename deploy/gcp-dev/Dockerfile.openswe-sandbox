FROM ghcr.io/astral-sh/uv@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded AS uv

FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates coreutils curl git gh jq openssh-client procps python3 \
       python3-venv ripgrep tar unzip xz-utils build-essential \
    && npm install --global pnpm@10.15.1 \
    && uv python install 3.14.6 \
    && uv --version \
    && uv python find 3.14.6 \
    && rm -rf /var/lib/apt/lists/* /root/.npm /root/.cache \
    && mkdir -p /workspace \
    && chown node:node /workspace

WORKDIR /workspace
USER node
CMD ["sleep", "infinity"]
