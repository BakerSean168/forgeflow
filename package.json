{
  "name": "forgeflow",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "clean": "rm -rf dist",
    "check:boundary": "npm run check:product-boundary && npm run check:architecture",
    "smoke:improvement-diagnosis": "tsx scripts/smoke-improvement-diagnosis.mts",
    "smoke:autonomous-lifecycle": "node scripts/smoke-autonomous-lifecycle.mjs",
    "check": "npm run check:boundary && npm run check:api-contract && npm run check:api-compat && npm run check:api-operations && npm run check:client-contract && npm run check-types && npm test && npm run test:client && npm run build && npm run build:client && npm run check:client-package",
    "check:product-boundary": "node scripts/check-product-boundary.mjs",
    "check:architecture": "node scripts/check-architecture-boundary.mjs",
    "api:spec": "tsx scripts/generate-openapi.mts",
    "check:api-contract": "tsx scripts/generate-openapi.mts --check",
    "client:generate": "tsx scripts/generate-client-types.mts",
    "check:client-contract": "tsx scripts/generate-client-types.mts --check",
    "test:client": "npm run test --workspace @forgeflow/client",
    "build:client": "npm run build --workspace @forgeflow/client",
    "check:client-package": "npm pack --workspace @forgeflow/client --dry-run --json",
    "check:api-compat": "tsx scripts/check-openapi-compat.mts",
    "check:api-operations": "tsx scripts/check-api-operations.mts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "version": "1.2.1",
  "description": "Autonomous software engineering system with durable planning, execution, review, recovery, delivery, and self-improvement.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/client"
  ]
}
