    "/api/v1/projects": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "description": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "execution": {
                            "additionalProperties": false,
                            "properties": {
                              "allowProviderNative": {
                                "type": "boolean"
                              },
                              "enabled": {
                                "type": "boolean"
                              },
                              "maxParallelWorkItems": {
                                "anyOf": [
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "workspace": {
                                "enum": [
                                  "canonical-fast-forward",
                                  "literal-worktree"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "enabled",
                              "workspace",
                              "allowProviderNative",
                              "maxParallelWorkItems"
                            ],
                            "type": "object"
                          },
                          "improvement": {
                            "additionalProperties": false,
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "enabled"
                            ],
                            "type": "object"
                          },
                          "projectKey": {
                            "type": "string"
                          },
                          "repositoryPath": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "source": {
                            "enum": [
                              "manifest",
                              "legacy-env"
                            ],
                            "type": "string"
                          },
                          "tags": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "projectKey",
                          "repositoryPath",
                          "tags",
                          "execution",
                          "improvement",
                          "source"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "source": {
                      "enum": [
                        "manifest",
                        "legacy-env",
                        "empty"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "count",
                    "source"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "List registered ForgeFlow projects",
        "tags": [
